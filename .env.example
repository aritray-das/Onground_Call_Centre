# .env.example
#
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env or .env.local — they are in .gitignore.
# Set the same names in the Vercel dashboard under Project → Settings → Environment Variables.

# ── Twilio credentials ────────────────────────────────────────────────────────

# Your Twilio Account SID (found on the Twilio Console dashboard, starts with AC)
TWILIO_ACCOUNT_SID=

# API Key SID (create under Twilio Console → Account → API Keys, starts with SK)
TWILIO_API_KEY_SID=

# API Key secret (shown only once when you create the API Key — copy it immediately)
TWILIO_API_KEY_SECRET=

# TwiML Application SID (create under Twilio Console → Voice → TwiML Apps, starts with AP)
# Set its Voice Request URL to https://<your-vercel-domain>/api/voice
TWILIO_TWIML_APP_SID=

# Verified Twilio phone number used as the outbound caller ID (E.164 format, e.g. +911234567890)
TWILIO_CALLER_ID=

# (Optional) Twilio Auth Token — when set, every webhook request from Twilio is
# signature-validated; leave empty to skip validation during local development
TWILIO_AUTH_TOKEN=

# ── Demo routing ──────────────────────────────────────────────────────────────

# (Optional) When set, ALL outbound calls are routed to this number regardless of
# what the user dials — useful for a fixed demo destination (E.164 format)
DEMO_ROUTE_TO=

# Comma-separated list of E.164 phone numbers that the demo is allowed to call
# (used only when DEMO_ROUTE_TO is not set); e.g. +911234567890,+919876543210
DEMO_ALLOWED_NUMBERS=

# ── Access control ────────────────────────────────────────────────────────────

# Shared passcode the browser sends in the x-demo-passcode header to obtain a token
# Use a long random string; never commit the real value
DEMO_PASSCODE=
